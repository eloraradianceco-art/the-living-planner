{
  "appId": "com.eloraradiance.livingplanner",
  "appName": "The Living Planner",
  "webDir": "dist",
  "backgroundColor": "#1A2332",
  "ios": {
    "backgroundColor": "#1A2332",
    "contentInset": "never"
  },
